+        ids=[str(i) for i in range(len(fig.axes))]
+        rows=[ids[:4],ids[4:]] if len(ids)==8 else None
+        cols=[[ids[i],ids[i+4]] for i in range(4)] if len(ids)==8 else [ids]
+        helper.require_matplotlib_panel_alignment(fig,axes=fig.axes,panel_ids=ids,
+            row_groups=rows,column_groups=cols,require_panel_labels=False,
+            json_out=directory/'PANEL_ALIGNMENT.json',overlay_svg=directory/'PANEL_ALIGNMENT_OVERLAY.svg')
