# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.Python

# Virtual environments
.venv/
venv/
env/

# ===== 构建产物 =====
# project/ 生成工程目录（保留 project/scripts/ 与 project/README.md）
project/*/
!project/scripts/
!project/scripts/**
!project/README.md
build/
dist/
out/
bin/
*.o
*.a
*.so
*.exe
*.dll
*.lib

# 本地运行日志
*.log
abc.history

# ===== 临时 / 草稿 =====
*.tmp
*.temp
*.bak
*.backup
*.old
*~
tmp/
scratch/*
!scratch/.gitkeep

# ===== 智能体本地工作区（记忆 / 会话数据，不入库；项目日志以 project_docs/LOGS.md 为准）=====
.workbuddy/

# ===== OS / 编辑器 / 同步噪音 =====
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
**/*_冲突文件_*
*.baiduyun.uploading.cfg

# ===== 实验输出（可再生，不提交；清单与汇总文档除外）=====
experiments/2026*/
experiments/tmp_*/

# ===== 原始基准数据（不提交；README 与部分 source_manifests 例外）=====
data/raw/*
!data/raw/.gitkeep
# git cannot re-include a file that lives inside an excluded DIRECTORY, so
# `data/raw/*` above (which excludes data/raw/benchmarks/) has to be undone
# for this directory FIRST -- otherwise the exceptions below never fire.
!data/raw/benchmarks/
# ... and the heavy subtrees are excluded again right away.
data/raw/benchmarks/raw/
data/raw/benchmarks/normalized/
data/raw/benchmarks/generated_cases/
!data/raw/benchmarks/README.md
!data/raw/benchmarks/source_manifests/
data/raw/benchmarks/source_manifests/epfl_v2025.1.json
data/raw/benchmarks/source_manifests/iscas85_jpsety_b4c6b620.json
data/derived/*
!data/derived/.gitkeep

# ===== 论文 scratch / 备份 / 审稿中间产物 =====
paper/zh/backups/
paper/zh/archives/
paper/zh/manuscript/backups/
paper/zh/manuscript/_*
paper/zh/manuscript/*.bak_*
paper/zh/figures/_*/
paper/zh/figures/nature/
paper/zh/figures/alt/
paper/zh/figures/*.bak
paper/zh/figures/*.bak_*

# LaTeX 中间文件
paper/zh/manuscript/*.aux
paper/zh/manuscript/*.out
paper/zh/manuscript/*.fls
paper/zh/manuscript/*.fdb_latexmk
paper/zh/manuscript/*.xdv
paper/zh/manuscript/*.synctex.gz

# 英文稿同款规则（此前只覆盖了 zh 侧，en 侧的 .aux/.out/.spl/.bak 会裸奔）
paper/en/manuscript/*.aux
paper/en/manuscript/*.out
paper/en/manuscript/*.spl
paper/en/manuscript/*.fls
paper/en/manuscript/*.fdb_latexmk
paper/en/manuscript/*.xdv
paper/en/manuscript/*.synctex.gz
paper/en/manuscript/_*
paper/en/manuscript/*.bak_*
# en 侧的入库 PDF 是 paper/en/build/FAECO.pdf，manuscript 下的那份是编译副本
paper/en/manuscript/FAECO.pdf

# XeLaTeX 编译所需但不再分发的字体
paper/zh/manuscript/fonts/

# ===== 安全（密钥 / 环境变量）=====
.env
.env.*
*.pem
*.key
*.p12
id_rsa*
*secret*

# ===== 旧排错证据（stale，不参与任何证据链；见 PAPER_EVIDENCE_MANIFEST.md §6）=====
experiments/_stale_*/
build_pass*.txt

# ===== 临时排错运行（下划线前缀，非证据族；需要留证时另建 experiments/2026xxxx_*）=====
experiments/_*/
